<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Primeiro contato com JavaScript</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background-color: #000000;
            font-family: 'poppins', sans-serif;
            display: flex;
            justify-content: center;
            text-align: center;
            flex-direction: column;
            text-shadow:
                -1px -1px 0 #000,
                1px -1px 0 #000,
                -1px 1px 0 #000,
                1px 1px 0 #000;
        }

        h1 {
            text-align: center;
            color: #a21212;
        }

        .card {
            display: grid;
            grid-template-columns: 1fr;
            margin: 20px auto;
            padding: 25px;
            border: 4px solid #ffffff;
            background-color: #27eafb;
            width: 400px;
            color: #ffffff;
            transition: transform 0.6s ease-in-out, box-shadow 0.6s ease-in-out, border-color 0.6s ease-in-out;
        }

        .card img {
            border: 4px solid #0d7eff;
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

        .card h2 {
            font-size: 30px;
        }

        .card p {
            font-size: 25px;
        }

        .card:hover {
            transform: translateY(-5px) scale(1.03);
            box-shadow: 0 0 15px #0d7eff,
                0 0 35px #0d7eff;
            border-color: #0d7eff;
        }

        .footer-text {
            font-size: 25px;
            color: #a21212;
        }

        @media (max-width: 768px) {
            .card {
                padding: 20px;
                margin: 15px auto;
                width: 90%;
            }
        }

        @media (max-width: 480px) {
            .card {
                padding: 15px;
                margin: 10px auto;
                width: 85%;
            }
        }
    </style>
</head>

<body>
    <header>
        <h1>Hoje é o meu primeiro contato com JavaScript</h1>
    </header>

    <main>
        <section class="card">
            <h2>Card do Hollow Knight</h2>
            <img src="Imagens/HK.logo.jpg" alt="Imagem do Hollow Knight">
            <p>Meu jogo Favorito </p>
            <button onclick="mostrarMensagem()">Clique aqui</button>
        </section>
    </main>

    <footer class="footer-text">
        <p>Sitezinho de hoje foi legal de fazer :)</p>
    </footer>

    <script>
        function mostrarMensagem() {
            alert("Você clicou no card do Hollow Knight!!")
            console.log("Bem vindo ao meu site!")
        }
    </script>
</body>

</html>