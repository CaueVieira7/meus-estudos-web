<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dando estilo pro meu site</title>
    <style>
        a {
                color: #0900E8
            }
        h1, h2 {
            color: #C20000;
             font-size: 35px;
        }
        p {
            color: #FFFFFF;
            font-size: 20px;
        }
        body {
            background-color:#000000;
             font-family: 'Poppins', sans-serif;
             font-variant: small-caps;
             text-align: center;
        }
        a:hover {
            background-color:#1800FF;
        }
        li, ul {
            color: #FFFFFF;
            font-size: 20px;
        }
        li {
    line-height: 2.0;
    margin-bottom: 15px;
}
