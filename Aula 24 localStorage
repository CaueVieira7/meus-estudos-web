    <!DOCTYPE html>
    <html lang="pt-br">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>BackLog de Jogos</title>
        <style>
            * {
                box-sizing: border-box;
            }

            body {
                background: linear-gradient(90deg, #061950, #510404);
                color: #fff;
                font-family: 'Poppins', sans-serif;
                display: flex;
                flex-direction: column;
                justify-content: center;
                text-align: center;
                min-width: 100vh;
                text-shadow:
                    -1px -1px #000,
                    1px -1px #000,
                    -1px 1px #000,
                    1px 1px #000;
            }

            table {
                border-collapse: collapse;
                background-color: #000;
                width: 100%;
                border: 2px solid #ffffff;
                box-shadow:
                    0 0 12px #7700f6,
                    0 0 30px #7700f6;
            }

            th,
            td {
                border: 2px solid #fff;
                padding: 10px;
            }

            .footer-text {
                font-size: 22px;
                text-align: center;
                color: #fff;
            }
        </style>
    </head>

    <body>
        <header>
            <h1>Listas de Jogos que quero jogar</h1>
        </header>
        <main>
            <section>
                <input type="text" id="nome-jogo" placeholder="Nome do jogo:">

                <select id="status-jogo">
                    <option value="Quero-jogar">Quero jogar</option>
                    <option value="Estou-jogando">Estou jogando</option>
                    <option value="Já-zerei">Já zerei</option>
                </select>

                <button onclick="adicionarJogo()">Adicionar</button>

                <table>
                    <thead>
                        <tr>
                            <th>Jogo</th>
                            <th>Status</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody id="corpo-tabela">

                    </tbody>
                </table>
            </section>
        </main>
        <footer class="footer-text">
            <p>Sitezinho de hoje foi legal de fazer</p>
        </footer>

        <script>
            let jogos = JSON.parse(localStorage.getItem("jogos")) || [];

            function renderizarJogos() {
                document.getElementById("corpo-tabela").innerHTML = "";
                jogos.forEach((jogo, indice) => {
                    document.getElementById("corpo-tabela").innerHTML += `
                    <tr>
                        <td>${jogo.nome}</td>
                        <td>${jogo.status}</td>
                        <td><button onclick="removerJogo(${indice})">Remover</button></td>
                    </tr>
                `;
                });
            }

            function removerJogo(indice) {
                jogos.splice(indice, 1);
                localStorage.setItem("jogos", JSON.stringify(jogos));
                renderizarJogos();
            }

                function adicionarJogo() {
                    let nome = document.getElementById("nome-jogo").value;
                    let status = document.getElementById("status-jogo").value;

                    jogos.push({ nome: nome, status: status });
                    localStorage.setItem("jogos", JSON.stringify(jogos));

                    renderizarJogos();
                }
                renderizarJogos();
        </script>
    </body>

    </html>