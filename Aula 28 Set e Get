<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cofre Digital</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background-color: #062233;
            color: #000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px 25px;
            min-height: 100vh;
        }

        html,
        body {
            margin: 0;
            height: 100%;
        }

        main {
            flex: 1;
            width: 100%;
            display: flex;
            justify-content: center;
        }

        section {
            width: 100%;
            max-width: 700px;
        }


        h1 {
            margin-bottom: 30px;
            color: #fff;
        }

        .footer-text {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100%;
            text-align: center;
            padding: 12px 0;
            background-color: #0a1823;
            color: #fff;
            z-index: 10;
            font-size: 25px;
        }

        .container {
            border: 2px solid #fff;
            color: #fff;
            background-color: #141414;
            padding: 30px;
            margin: 20px auto 0;
            display: grid;
            text-align: center;
            grid-template-columns: 1fr;
            gap: 18px;
            height: 500px;
            min-width: 500px;
        }

        .container input {
            width: 600px;
            height: 60px;
            margin: 0 auto;
            padding: 9px;
            font-size: 15px;
            background-color: #000;
            color: #ba9f08;
            border: 2px solid #fff;
        }

        .container input::placeholder {
            color: #ba9f08;
            opacity: 0.8;
        }

        .botoes {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .botoes button {
            width: 120px;
            padding: 10px 12px;
            font-size: 15px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background-color: #000;
            color: #ffd700;
            border: 2px solid #fff;
            transition: transform 0.4s ease-in-out,
                border-color 0.4s ease-in-out;
        }

        .botoes button:hover {
            transform: translateY(-3px) scale(1.02);
            border-color: #ffd700;
        }

        #log-transacoes {
            max-height: 150px;
            min-height: 30px;
            overflow-y: auto;
            width: 100%;
            background: #ffffff05;
            border-radius: 8px;
            padding: 8px;
            box-sizing: border-box;
            text-align: left;
        }

        #log-transacoes p {
            margin: 4px 0;
            color: #fff;
        }

        p.erro {
            color: #eb0808;
            min-height: 24px;
            margin: 0;
        }
    </style>
</head>

<body>
    <header>
        <h1>Seu Cofre Digital</h1>
    </header>
    <main>
        <section class="container">
            <h2>Digite abaixo a quantia que deseja sacar ou depositar.</h2>
            <input type="number" id="saldo" placeholder="30, 470, 1000...">
            <p>Saldo atual: <span id="saldo-atual"></span></p>
            <p id="erro"></p>

            <div id="log-transacoes"></div>

            <div class="botoes">
                <button onclick="sacarDinheiro()">Sacar</button>
                <button onclick="depositarDinheiro()">Depósitar</button>
            </div>

        </section>
    </main>
    <footer class="footer-text">
        <p>Sitezinho pra simular um cofre :)</p>
    </footer>

    <script>
        class ContaBanco {
            #saldo;

            constructor(saldoInicial) {
                this.#saldo = saldoInicial
            }

            get saldo() {
                return this.#saldo;
            }

            set saldo(novoValor) {
                if (novoValor < 0) {
                    document.getElementById("erro").textContent = "O saldo novo não pode ser negativo!"
                } else {
                    this.#saldo = novoValor
                }
            }

            depositar(valor) {
                this.saldo = this.saldo + valor;
            }

            sacar(valor) {
                if (valor > this.saldo) {
                    document.getElementById("erro").textContent = "Saldo insuficiente para saque!";
                } else {
                    this.saldo = this.saldo - valor;
                }
            }
        }

        let minhaConta = new ContaBanco(100);

        function atualizarSaldoNaTela() {
            document.getElementById("saldo-atual").textContent = minhaConta.saldo;
        }

        function depositarDinheiro() {
            let valor = Number(document.getElementById("saldo").value);

            if (valor <= 0) {
                document.getElementById("erro").textContent = "Digite um valor maior que zero!";
                return;
            }

            minhaConta.depositar(valor);
            atualizarSaldoNaTela();
            document.getElementById("log-transacoes").innerHTML += `<p>Depósito de ${valor}</p>`;
        }

        function sacarDinheiro() {
            let valor = Number(document.getElementById("saldo").value);

            if (valor <= 0) {
                document.getElementById("erro").textContent = "Digite um valor maior que zero!";
                return;
            }

            minhaConta.sacar(valor);
            atualizarSaldoNaTela();
            document.getElementById("log-transacoes").innerHTML += `<p>Saque de ${valor}</p>`;
        }

        atualizarSaldoNaTela();
    </script>
</body>

</html>