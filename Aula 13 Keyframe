<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carregando...</title>
    <style>
        * {
            box-sizing: border-box;
        }
        
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #212e57, #07112c);
            color: #ffffff;
            font-family: arial, sans-serif;
        }

        .page {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .topo {
            text-transform: uppercase;
            letter-spacing: 2px;
            opacity: 0.8;
            font-size: 0.85rem;
        }

        .loading-screen {
            text-align: center;
            width: 420px;
        }

        h1 {
            font-size: 2.4rem;
            margin: 0;
            animation: pulse-text 1.4s ease-in-out infinite;
        }

        @keyframes pulse-text {
            0% {
                transform: scale(0.95);
                opacity: 0.8;
            }
            50% {
                transform: scale(1.08);
                opacity: 1;
            }
            100% {
                transform: scale(0.95);
                opacity: 0.8;
            }
        }

        .progress-track {
            width: 100%;
            height: 12px;
            background: #ffffff26;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 20px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            border-radius: inherit;
            background: linear-gradient(90deg, #00d4ff, #7b34f5);
            animation: fill-bar 3s ease-in-out infinite;
        }

        @keyframes fill-bar {
            0% {
                width: 0%;
            }
            50% {
                width: 80%;
            }
            100% {
                width: 100%;
            }
        }

        .loading-screen {
            width: 420px;
            text-align: center;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .loader-icon {
            display: inline-block;
            animation: spin 2.4s linear infinite;
            margin-bottom: 15px;
            font-size: 4rem;
            text-shadow: 0 0 20px #7c3aedcc;
        }

        .loader-icon img {
            width: 90px;
            height: 90px;
            display: block;
            border-radius: 50%;
            box-shadow: 0 0 20px #7c3aedcc;
        }

        .rodape {
            font-size: 0.8rem;
            opacity: 0.7;
        }
    </style>
</head>

<body>
<main class="page">
    <header class="topo">
        <p>Jogo em andamento</p>
    </header>

    <section class="loading-screen" aria-label="Tela de carregamento">
        <div class="loader-icon">⚔️</div>
        <h1>Carregando...</h1>

        <div class="progress-track" aria-label="Barra de progresso">
            <div class="progress-bar"></div>
        </div>
    </section>

    <footer class="rodape">
        <p>Preparando a partida...</p>
    </footer>
</main>
</body>

</html>